{
  "app": {
    "bundleName": "com.aira.browser",
    "vendor": "airabrowser",
    "versionCode": 1000389,
    "versionName": "2.7.1",
    "icon": "$media:layered_image",
    "label": "$string:app_name",
    "configuration": "$profile:configuration",
    "cloudStructuredDataSyncEnabled": true,
    "multiAppMode": {
      "multiAppModeType": "appClone",
      "maxCount": 2
    }
  }
}
