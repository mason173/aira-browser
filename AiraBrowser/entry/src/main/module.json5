    ],
    "extensionAbilities": [
      {
        "name": "EntryBackupAbility",
        "srcEntry": "./ets/entrybackupability/EntryBackupAbility.ets",
        "type": "backup",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.backup",
            "resource": "$profile:backup_config"
          }
        ]
      },
      {
        "name": "AiraSearchFormAbility",
        "srcEntry": "./ets/entryformability/AiraSearchFormAbility.ets",
        "label": "$string:aira_search_card_display_name",
        "description": "$string:aira_search_card_description",
        "type": "form",
