export function localizeAppearanceSettingsCopy(value: ResourceStr): ResourceStr {
  if (typeof value !== 'string') {
    return value;
  }
  switch (value) {
    case '浅色':
      return $r('app.string.settings_appearance_light');
    case '深色':
      return $r('app.string.settings_appearance_dark');
    case '跟随系统':
      return $r('app.string.settings_screen_orientation_system_title');
    case '当前会话不可修改全局设置':
      return $r('app.string.settings_appearance_session_locked');
    case '主题色':
      return $r('app.string.settings_appearance_theme_color');
    case '选择内置颜色风格':
      return $r('app.string.settings_appearance_theme_color_detail');
    case '应用图标':
      return $r('app.string.settings_appearance_app_icon');
    case '可切换':
      return $r('app.string.settings_appearance_switchable');
    case '切换桌面应用图标':
      return $r('app.string.settings_appearance_app_icon_detail');
    case '强制网页深色':
      return $r('app.string.settings_appearance_force_dark');
    case '标签页样式':
      return $r('app.string.settings_appearance_tab_style');
    case '界面模式':
      return $r('app.string.settings_appearance_interface_mode');
    case '显示书签栏':
      return $r('app.string.settings_appearance_bookmark_bar');
    case '横向大卡片':
      return $r('app.string.settings_appearance_large_cards');
    case '堆叠式':
      return $r('app.string.settings_appearance_stack');
    case '列表式':
      return $r('app.string.settings_appearance_list');
    case '卡片平铺':
      return $r('app.string.settings_appearance_grid');
    case '双击关闭标签页':
      return $r('app.string.settings_appearance_double_click_close_tabs');
    case '在垂直标签栏中双击鼠标或连续轻点两次，即可关闭标签页。':
      return $r('app.string.settings_appearance_double_click_close_tabs_detail');
    case '垂直标签页':
      return $r('app.string.settings_appearance_vertical_tabs');
    case '水平标签页':
      return $r('app.string.settings_appearance_horizontal_tabs');
    case '一律隐藏':
      return $r('app.string.bookmark_bar_visibility_never');
    case '一律显示':
      return $r('app.string.bookmark_bar_visibility_always');
    case '仅在“新标签页”页面上显示':
      return $r('app.string.bookmark_bar_visibility_new_tab');
    case '触屏界面':
      return $r('app.string.settings_appearance_touch');
    case '桌面界面':
      return $r('app.string.settings_appearance_desktop');
    case '自动':
      return $r('app.string.settings_appearance_auto');
    case '水平标签页在窗口顶部，垂直标签页在窗口一侧。':
      return $r('app.string.settings_appearance_desktop_tabs_footer');
    case '只改变标签管理页的排列方式，不影响网页内容和恢复。':
      return $r('app.string.settings_appearance_phone_tabs_footer');
    case '仅在平板和桌面窗口显示，设置保存在本设备。':
      return $r('app.string.settings_appearance_bookmark_bar_footer');
    case '标签页样式更新失败，请稍后重试。':
      return $r('app.string.settings_appearance_tab_style_failed');
    case '默认':
      return $r('app.string.web_text_zoom_default');
    case '晨光':
      return $r('app.string.settings_appearance_palette_dawn');
    case '铅云':
      return $r('app.string.settings_appearance_palette_pewter');
    case '晨屿':
      return $r('app.string.settings_appearance_palette_harbor');
    case '竹影':
      return $r('app.string.settings_appearance_palette_bamboo');
    case '森息':
      return $r('app.string.settings_appearance_palette_forest');
    case '潮镜':
      return $r('app.string.settings_appearance_palette_tide');
    case '薄霁':
      return $r('app.string.settings_appearance_palette_mist');
    case '夜航':
      return $r('app.string.settings_appearance_palette_night');
    case '云藤':
      return $r('app.string.settings_appearance_palette_wisteria');
    case '绯页':
      return $r('app.string.settings_appearance_palette_crimson');
    case '暖砖':
      return $r('app.string.settings_appearance_palette_brick');
    case '灯穗':
      return $r('app.string.settings_appearance_palette_lantern');
    case '苔径':
      return $r('app.string.settings_appearance_palette_moss');
    case '晴瓷':
      return $r('app.string.settings_appearance_palette_porcelain');
    case '雾钢':
      return $r('app.string.settings_appearance_palette_steel');
    case '暮梅':
      return $r('app.string.settings_appearance_palette_plum');
    case '橙潮':
      return $r('app.string.settings_appearance_palette_citrus');
    default:
      return value;
  }
}
