/** The English text for a Chinese directory identity, or `''` when there is none. */
export function settingsCatalogEnglishText(value: string): string {
  const english = SETTINGS_CATALOG_ENGLISH_INDEX.get(value);
  return english === undefined ? '' : english;
}
