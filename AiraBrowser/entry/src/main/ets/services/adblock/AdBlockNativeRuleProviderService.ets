import { taskpool, util } from '@kit.ArkTS';
import { fileIo } from '@kit.CoreFileKit';
import { AppRuntimeContext } from '../../app/runtime/AppRuntimeContext';
import {
  AdBlockCustomRuleSource,
  AdBlockSettings
} from '../../common/models/BrowserModels';
import { isAdBlockThirdPartyRuleSourceId } from '../../features/adblock/AdBlockThirdPartyRuleSourceCatalog';
import {
  AdBlockNativeAuthorityBuildResult,
  AdBlockNativeAuthorityEngineService
} from './AdBlockNativeAuthorityEngineService';

export interface AdBlockNativeRuleProviderResult {
  success: boolean;
  applied: boolean;
  skipped: boolean;
  reason: string;
  sourceCount: number;
  ruleLineCount: number;
  identity: string;
  rulesetPath: string;
  sourceIds: string[];
}

export interface AdBlockNativeSourcePayloadInfo {
  identity: string;
  networkRuleCount: number;
  cosmeticRuleCount: number;
  ruleCount: number;
}

interface AdBlockNativeRuleProviderManifest {
  schemaVersion: number;
  identity: string;
  sourceIds: string[];
  sourcePayloadIdentities: string[];
  ruleLineCount: number;
}

const NATIVE_PROVIDER_SCHEMA_VERSION: number = 5;
const NATIVE_PROVIDER_ROOT_DIR_NAME: string = 'adblock-native-provider-v1';
const NATIVE_PROVIDER_RULESET_FILE_NAME: string = 'enabled-rules.txt';
const NATIVE_PROVIDER_MANIFEST_FILE_NAME: string = 'manifest.json';
const MAX_NATIVE_SOURCE_BYTES: number = 8 * 1024 * 1024;
const MAX_NATIVE_SOURCE_IDENTITY_BYTES: number = 256;
const MAX_NATIVE_RULESET_BYTES: number = 40 * 1024 * 1024;
const MAX_NATIVE_MANIFEST_BYTES: number = 32 * 1024;
const RAW_PAYLOAD_HASH_SEED: number = 2166136261;
const RAW_PAYLOAD_HASH_SECONDARY_SEED: number = 3335557771;

@Concurrent
function buildNativeRulesetCandidate(
  sourcePaths: string[],
  sourceTitles: string[],
  outputPath: string,
  maxBytes: number
): number {
  let outputFile: fileIo.File | undefined = undefined;
  let completed: boolean = false;
  try {
    outputFile = fileIo.openSync(
      outputPath,
      fileIo.OpenMode.WRITE_ONLY | fileIo.OpenMode.CREATE | fileIo.OpenMode.TRUNC
    );
    const encoder: util.TextEncoder = util.TextEncoder.create('utf-8');
    const rules: Set<string> = new Set<string>();
    let chunk: string = '[Adblock Plus 2.0]\n! Generated by Aira for the Rust filtering authority.\n';
    let writtenBytes: number = 0;
    let ruleLineCount: number = 0;
    for (let sourceIndex: number = 0; sourceIndex < sourcePaths.length; sourceIndex += 1) {
      const title: string = sourceTitles[sourceIndex].replace(/[\r\n]+/g, ' ').trim();
      chunk += `! Source: ${title}\n`;
      const sourcePayload: string = fileIo.readTextSync(sourcePaths[sourceIndex]);
      const lines: string[] = sourcePayload.replace(/\r\n/g, '\n').replace(/\r/g, '\n').split('\n');
      for (let lineIndex: number = 0; lineIndex < lines.length; lineIndex += 1) {
        const line: string = lines[lineIndex];
        const normalized: string = line.trim();
        if (normalized.length === 0 || /^\[Adblock(?: Plus)?[^\]]*\]$/i.test(normalized)) {
          continue;
        }
        if (normalized.startsWith('!')) {
          chunk += `${line}\n`;
        } else if (!rules.has(normalized)) {
          rules.add(normalized);
          chunk += `${line}\n`;
          ruleLineCount += 1;
        }
        if (chunk.length < 256 * 1024) {
          continue;
        }
        const chunkBytes: Uint8Array = encoder.encodeInto(chunk);
        if (writtenBytes + chunkBytes.byteLength > maxBytes) {
          throw new Error('原生规则集超出大小限制');
        }
        const chunkBuffer: ArrayBuffer = new ArrayBuffer(chunkBytes.byteLength);
        new Uint8Array(chunkBuffer).set(chunkBytes);
        const written: number = fileIo.writeSync(outputFile.fd, chunkBuffer);
        if (written !== chunkBytes.byteLength) {
          throw new Error('原生规则集写入不完整');
        }
        writtenBytes += written;
        chunk = '';
      }
    }
    chunk += '\n';
    const finalBytes: Uint8Array = encoder.encodeInto(chunk);
    if (writtenBytes + finalBytes.byteLength > maxBytes) {
      throw new Error('原生规则集超出大小限制');
    }
    const finalBuffer: ArrayBuffer = new ArrayBuffer(finalBytes.byteLength);
    new Uint8Array(finalBuffer).set(finalBytes);
    const finalWritten: number = fileIo.writeSync(outputFile.fd, finalBuffer);
    if (finalWritten !== finalBytes.byteLength) {
      throw new Error('原生规则集写入不完整');
    }
    fileIo.fsyncSync(outputFile.fd);
    completed = true;
    return ruleLineCount;
  } catch (_error) {
    throw new Error('原生规则集合并失败');
  } finally {
    if (outputFile !== undefined) {
      try {
        fileIo.closeSync(outputFile);
      } catch (_error) {
      }
    }
    if (!completed) {
      try {
        fileIo.unlinkSync(outputPath);
      } catch (_error) {
      }
    }
  }
}

export class AdBlockNativeRuleProviderService {
  private readonly encoder: util.TextEncoder = util.TextEncoder.create('utf-8');
  private readonly decoder: util.TextDecoder = util.TextDecoder.create('utf-8');
  private readonly nativeAuthorityEngine: AdBlockNativeAuthorityEngineService =
    new AdBlockNativeAuthorityEngineService();
  private mutationTask: Promise<void> = Promise.resolve();
  private activeIdentity: string = '';
  private nativeStateUncertain: boolean = false;

  clearAllArtifacts(): Promise<void> {
    return this.enqueue(async (): Promise<void> => {
      this.activeIdentity = '';
      this.nativeStateUncertain = true;
      const root = this.getRootDir();
      if (!await fileIo.access(root)) {
        this.nativeStateUncertain = false;
        return;
      }
      const names: string[] = await fileIo.listFile(root);
      for (let index = 0; index < names.length; index += 1) {
        const name = names[index];
        if (name.indexOf('/') >= 0 || name.indexOf('\\') >= 0) {
          throw new Error('原生规则目录包含无效文件名');
        }
        const path = `${root}/${name}`;
        const stat = await fileIo.stat(path);
        if (stat.isDirectory()) {
          throw new Error('原生规则目录包含未知子目录');
        }
        await fileIo.unlink(path);
      }
      await fileIo.rmdir(root);
      this.nativeStateUncertain = false;
    });
  }

  stageSourcePayload(sourceId: string, payload: string): Promise<string> {
    if (!this.isSupportedSourceId(sourceId)) {
      return Promise.reject(new Error('原生规则源 ID 不受支持'));
    }
    let identity: string = '';
    return this.enqueue(async (): Promise<void> => {
      const bytes: Uint8Array = this.encoder.encodeInto(payload);
      if (bytes.byteLength <= 0 || bytes.byteLength > MAX_NATIVE_SOURCE_BYTES) {
        throw new Error('原生规则源文件大小无效');
      }
      await this.ensureRootDir();
      await this.writeBytes(this.getSourceNextPath(sourceId), bytes, MAX_NATIVE_SOURCE_BYTES);
      identity = this.buildRawPayloadIdentity(bytes);
      const identityBytes: Uint8Array = this.encoder.encodeInto(identity);
      await this.writeBytes(
        this.getSourceIdentityNextPath(sourceId),
        identityBytes,
        MAX_NATIVE_SOURCE_IDENTITY_BYTES
      );
    }).then((): string => identity);
  }

  validateStagedSourcePayload(sourceId: string): Promise<AdBlockNativeSourcePayloadInfo> {
    if (!this.isSupportedSourceId(sourceId)) {
      return Promise.reject(new Error('原生规则源 ID 不受支持'));
    }
    let info: AdBlockNativeSourcePayloadInfo | undefined = undefined;
    return this.enqueue(async (): Promise<void> => {
      const path: string = this.getSourceNextPath(sourceId);
      if (!await this.pathExists(path)) {
        throw new Error('原生规则源候选文件不存在');
      }
      const buildResult: AdBlockNativeAuthorityBuildResult = await this.nativeAuthorityEngine.buildEngine(path);
      try {
        const identityPath: string = this.getSourceIdentityNextPath(sourceId);
        const identityStat = await fileIo.stat(identityPath);
        const identity = (await this.readText(identityPath, Math.floor(identityStat.size))).trim();
        info = this.buildSourcePayloadInfo(identity, buildResult);
      } finally {
        this.nativeAuthorityEngine.releaseEngine(buildResult.handle);
      }
    }).then((): AdBlockNativeSourcePayloadInfo => {
      if (info === undefined) {
        throw new Error('原生规则源校验失败');
      }
      return info;
    });
  }

  inspectSourcePayload(sourceId: string): Promise<AdBlockNativeSourcePayloadInfo | undefined> {
    if (!this.isSupportedSourceId(sourceId)) {
      return Promise.resolve(undefined);
    }
    let info: AdBlockNativeSourcePayloadInfo | undefined = undefined;
    return this.enqueue(async (): Promise<void> => {
      const identity: string | undefined = await this.readValidatedSourceIdentity(sourceId);
      if (identity === undefined) {
        return;
      }
      const buildResult: AdBlockNativeAuthorityBuildResult =
        await this.nativeAuthorityEngine.buildEngine(this.getSourcePath(sourceId));
      try {
        info = this.buildSourcePayloadInfo(identity, buildResult);
      } finally {
        this.nativeAuthorityEngine.releaseEngine(buildResult.handle);
      }
    }).then((): AdBlockNativeSourcePayloadInfo | undefined => info);
  }

  commitStagedSourcePayload(sourceId: string): Promise<void> {
    if (!this.isSupportedSourceId(sourceId)) {
      return Promise.resolve();
    }
    return this.enqueue(async (): Promise<void> => {
      const finalPath: string = this.getSourcePath(sourceId);
      const nextPath: string = this.getSourceNextPath(sourceId);
      const previousPath: string = this.getSourcePreviousPath(sourceId);
      const identityPath: string = this.getSourceIdentityPath(sourceId);
      const identityNextPath: string = this.getSourceIdentityNextPath(sourceId);
      const identityPreviousPath: string = this.getSourceIdentityPreviousPath(sourceId);
      if (!await this.pathExists(nextPath) || !await this.pathExists(identityNextPath)) {
        throw new Error('原生规则源候选文件不存在');
      }
      let payloadFinalMoved: boolean = false;
      let identityFinalMoved: boolean = false;
      let payloadCandidateInstalled: boolean = false;
      let identityCandidateInstalled: boolean = false;
      try {
        await this.removePath(previousPath);
        await this.removePath(identityPreviousPath);
        if (await this.pathExists(finalPath)) {
          await fileIo.rename(finalPath, previousPath);
          payloadFinalMoved = true;
        }
        if (await this.pathExists(identityPath)) {
          await fileIo.rename(identityPath, identityPreviousPath);
          identityFinalMoved = true;
        }
        await fileIo.rename(nextPath, finalPath);
        payloadCandidateInstalled = true;
        await fileIo.rename(identityNextPath, identityPath);
        identityCandidateInstalled = true;
      } catch (_error) {
        if (payloadCandidateInstalled) {
          await this.removePath(finalPath);
        }
        if (payloadFinalMoved) {
          await fileIo.rename(previousPath, finalPath);
        }
        if (identityCandidateInstalled) {
          await this.removePath(identityPath);
        }
        if (identityFinalMoved) {
          await fileIo.rename(identityPreviousPath, identityPath);
        }
        throw new Error('原生规则源提交失败');
      }
    });
  }

  completeStagedSourcePayload(sourceId: string): Promise<void> {
    if (!this.isSupportedSourceId(sourceId)) {
      return Promise.resolve();
    }
    return this.enqueue(async (): Promise<void> => {
      await this.removePath(this.getSourcePreviousPath(sourceId));
      await this.removePath(this.getSourceNextPath(sourceId));
      await this.removePath(this.getSourceIdentityPreviousPath(sourceId));
      await this.removePath(this.getSourceIdentityNextPath(sourceId));
    });
  }

  rollbackStagedSourcePayload(sourceId: string): Promise<void> {
    if (!this.isSupportedSourceId(sourceId)) {
      return Promise.resolve();
    }
    return this.enqueue(async (): Promise<void> => {
      const finalPath: string = this.getSourcePath(sourceId);
      const previousPath: string = this.getSourcePreviousPath(sourceId);
      const identityPath: string = this.getSourceIdentityPath(sourceId);
      const identityPreviousPath: string = this.getSourceIdentityPreviousPath(sourceId);
      if (await this.pathExists(previousPath)) {
        await this.removePath(finalPath);
        await fileIo.rename(previousPath, finalPath);
      } else {
        await this.removePath(finalPath);
      }
      if (await this.pathExists(identityPreviousPath)) {
        await this.removePath(identityPath);
        await fileIo.rename(identityPreviousPath, identityPath);
      } else {
        await this.removePath(identityPath);
      }
      await this.removePath(this.getSourceNextPath(sourceId));
      await this.removePath(this.getSourceIdentityNextPath(sourceId));
    });
  }

  discardStagedSourcePayload(sourceId: string): Promise<void> {
    if (!this.isSupportedSourceId(sourceId)) {
      return Promise.resolve();
    }
    return this.enqueue(async (): Promise<void> => {
      await this.removePath(this.getSourceNextPath(sourceId));
      await this.removePath(this.getSourceIdentityNextPath(sourceId));
    });
  }

  removeSourcePayload(sourceId: string): Promise<void> {
    if (!this.isSupportedSourceId(sourceId)) {
      return Promise.resolve();
    }
    return this.enqueue(async (): Promise<void> => {
      await this.removePath(this.getSourcePath(sourceId));
      await this.removePath(this.getSourceNextPath(sourceId));
      await this.removePath(this.getSourcePreviousPath(sourceId));
      await this.removePath(this.getSourceIdentityPath(sourceId));
      await this.removePath(this.getSourceIdentityNextPath(sourceId));
      await this.removePath(this.getSourceIdentityPreviousPath(sourceId));
    });
  }

  async reconcile(
    settings: AdBlockSettings,
    forceSourceValidation: boolean = false
  ): Promise<AdBlockNativeRuleProviderResult> {
    let result: AdBlockNativeRuleProviderResult = this.skipped('not_started', 0);
    await this.enqueue(async (): Promise<void> => {
      result = await this.reconcileNow(settings, forceSourceValidation);
    });
    return result;
  }

  private async reconcileNow(
    settings: AdBlockSettings,
    forceSourceValidation: boolean
  ): Promise<AdBlockNativeRuleProviderResult> {
    if (!AppRuntimeContext.hasApplicationContext()) {
      return this.failure('application_context_unavailable', 0);
    }
    const sources: AdBlockCustomRuleSource[] = this.resolveEffectiveSources(settings);
    const availableSources: AdBlockCustomRuleSource[] = [];
    const sourcePayloadIdentities: string[] = [];
    const sourcePaths: string[] = [];
    const sourceTitles: string[] = [];
    if (sources.length === 0) {
      const identity: string = this.buildIdentity(availableSources, sourcePayloadIdentities);
      this.activeIdentity = identity;
      this.nativeStateUncertain = false;
      return this.skipped('no_enabled_rule_sources', 0);
    }
    try {
      await this.ensureRootDir();
      if (!forceSourceValidation) {
        const persistedResult = await this.resolvePersistedAuthority(sources);
        if (persistedResult !== undefined) {
          return persistedResult;
        }
      }
      for (let index = 0; index < sources.length; index += 1) {
        const source: AdBlockCustomRuleSource = sources[index];
        if (!this.isSupportedSourceId(source.id)) {
          continue;
        }
        const rawIdentity: string | undefined = await this.readValidatedSourceIdentity(source.id);
        if (rawIdentity === undefined) {
          continue;
        }
        availableSources.push(source);
        sourcePayloadIdentities.push(rawIdentity);
        sourcePaths.push(this.getSourcePath(source.id));
        sourceTitles.push(source.title);
      }
      if (availableSources.length === 0) {
        return this.failure('raw_source_payload_unavailable', 0);
      }
      const sourceIds: string[] = availableSources.map((source: AdBlockCustomRuleSource) => source.id);
      const identity: string = this.buildIdentity(availableSources, sourcePayloadIdentities);
      const rulesetPath: string = this.getRulesetPath();
      const nextPath: string = this.getRulesetNextPath();
      await this.removePath(nextPath);
      const mergeTask: taskpool.Task = new taskpool.Task(
        'aira-adblock-native-ruleset',
        buildNativeRulesetCandidate,
        sourcePaths,
        sourceTitles,
        nextPath,
        MAX_NATIVE_RULESET_BYTES
      );
      const ruleLineCount: number = await taskpool.execute(mergeTask, taskpool.Priority.LOW) as number;
      await this.commitRulesetCandidate();
      this.activeIdentity = '';
      this.nativeStateUncertain = true;
      await this.writeManifest({
        schemaVersion: NATIVE_PROVIDER_SCHEMA_VERSION,
        identity: identity,
        sourceIds: sourceIds,
        sourcePayloadIdentities: sourcePayloadIdentities,
        ruleLineCount: ruleLineCount
      });
      await this.removePath(this.getRulesetPreviousPath());
      this.activeIdentity = identity;
      this.nativeStateUncertain = false;
      return {
        success: true,
        applied: true,
        skipped: false,
        reason: 'applied',
        sourceCount: availableSources.length,
        ruleLineCount: ruleLineCount,
        identity: identity,
        rulesetPath: rulesetPath,
        sourceIds: sourceIds
      };
    } catch (_error) {
      await this.restoreRuleset();
      return this.failure('native_ruleset_apply_failed', sources.length);
    }
  }

  resolveEffectiveSources(settings: AdBlockSettings): AdBlockCustomRuleSource[] {
    if (!settings.preferences.enabled) {
      return [];
    }
    return settings.customRuleSources.filter((source: AdBlockCustomRuleSource) => {
      return source.sourceType !== 'system' && source.enabled && source.ruleCount > 0;
    });
  }

  private async resolvePersistedAuthority(
    sources: AdBlockCustomRuleSource[]
  ): Promise<AdBlockNativeRuleProviderResult | undefined> {
    if (this.nativeStateUncertain) {
      return undefined;
    }
    const sourceIds: string[] = [];
    const sourcePayloadIdentities: string[] = [];
    for (let index: number = 0; index < sources.length; index += 1) {
      const source: AdBlockCustomRuleSource = sources[index];
      const payloadIdentity: string = source.payloadIdentity.trim();
      if (!this.isSupportedSourceId(source.id) || !this.isValidRawPayloadIdentity(payloadIdentity)) {
        return undefined;
      }
      sourceIds.push(source.id);
      sourcePayloadIdentities.push(payloadIdentity);
    }
    const manifest: AdBlockNativeRuleProviderManifest | undefined = await this.readManifest();
    if (manifest === undefined || manifest.ruleLineCount <= 0 ||
      !this.areStringArraysEqual(manifest.sourceIds, sourceIds) ||
      !this.areStringArraysEqual(manifest.sourcePayloadIdentities, sourcePayloadIdentities)) {
      return undefined;
    }
    const identity: string = this.buildIdentity(sources, sourcePayloadIdentities);
    if (manifest.identity !== identity || !await this.isUsableRulesetFile(this.getRulesetPath())) {
      return undefined;
    }
    const alreadyActiveInProcess: boolean = identity === this.activeIdentity;
    this.activeIdentity = identity;
    return this.skipped(
      alreadyActiveInProcess ? 'already_active_in_process' : 'persisted_manifest_matched',
      sources.length,
      manifest.ruleLineCount,
      identity,
      this.getRulesetPath(),
      sourceIds
    );
  }

  private areStringArraysEqual(left: string[], right: string[]): boolean {
    if (left.length !== right.length) {
      return false;
    }
    for (let index: number = 0; index < left.length; index += 1) {
      if (left[index] !== right[index]) {
        return false;
      }
    }
    return true;
  }

  private async isUsableRulesetFile(path: string): Promise<boolean> {
    try {
      const stat = await fileIo.stat(path);
      return !stat.isDirectory() && stat.size > 0 && stat.size <= MAX_NATIVE_RULESET_BYTES;
    } catch (_error) {
      return false;
    }
  }

  private buildSourcePayloadInfo(
    identity: string,
    buildResult: AdBlockNativeAuthorityBuildResult
  ): AdBlockNativeSourcePayloadInfo {
    return {
      identity: identity,
      networkRuleCount: Math.max(0, Math.floor(buildResult.networkRuleCount)),
      cosmeticRuleCount: Math.max(0, Math.floor(buildResult.cosmeticRuleCount)),
      ruleCount: Math.max(0, Math.floor(buildResult.ruleCount))
    };
  }

  private buildIdentity(
    sources: AdBlockCustomRuleSource[],
    sourcePayloadIdentities: string[]
  ): string {
    if (sources.length === 0) {
      return `v${NATIVE_PROVIDER_SCHEMA_VERSION}:empty`;
    }
    const parts: string[] = [];
    sources.forEach((source: AdBlockCustomRuleSource, index: number) => {
      parts.push(`${source.id}:${sourcePayloadIdentities[index]}`);
    });
    return `v${NATIVE_PROVIDER_SCHEMA_VERSION}:` + parts.join('|');
  }

  private async readValidatedSourceIdentity(sourceId: string): Promise<string | undefined> {
    const path: string = this.getSourcePath(sourceId);
    try {
      const stat = await fileIo.stat(path);
      if (stat.isDirectory() || stat.size <= 0 || stat.size > MAX_NATIVE_SOURCE_BYTES) {
        return undefined;
      }
      const identity: string | undefined = await this.readSourceIdentity(sourceId);
      if (identity === undefined) {
        return undefined;
      }
      const payloadBytes: Uint8Array = await this.readBytes(path, Math.floor(stat.size));
      return this.buildRawPayloadIdentity(payloadBytes) === identity ? identity : undefined;
    } catch (_error) {
      return undefined;
    }
  }

  private async readSourceIdentity(sourceId: string): Promise<string | undefined> {
    const path: string = this.getSourceIdentityPath(sourceId);
    try {
      const stat = await fileIo.stat(path);
      if (stat.isDirectory() || stat.size <= 0 || stat.size > MAX_NATIVE_SOURCE_IDENTITY_BYTES) {
        return undefined;
      }
      const identity: string = (await this.readText(path, Math.floor(stat.size))).trim();
      return this.isValidRawPayloadIdentity(identity) ? identity : undefined;
    } catch (_error) {
      return undefined;
    }
  }

  private isValidRawPayloadIdentity(identity: string): boolean {
    return /^raw-v1-[0-9a-f]{16}$/.test(identity);
  }

  private async commitRulesetCandidate(): Promise<void> {
    const finalPath: string = this.getRulesetPath();
    const nextPath: string = this.getRulesetNextPath();
    const previousPath: string = this.getRulesetPreviousPath();
    const candidateStat = await fileIo.stat(nextPath);
    if (candidateStat.isDirectory() || candidateStat.size <= 0 || candidateStat.size > MAX_NATIVE_RULESET_BYTES) {
      throw new Error('原生规则集大小无效');
    }
    let finalMoved: boolean = false;
    try {
      await this.removePath(previousPath);
      if (await this.pathExists(finalPath)) {
        await fileIo.rename(finalPath, previousPath);
        finalMoved = true;
      }
      await fileIo.rename(nextPath, finalPath);
    } catch (_error) {
      if (finalMoved) {
        await fileIo.rename(previousPath, finalPath);
      }
      throw new Error('原生规则集提交失败');
    }
  }

  private async restoreRuleset(): Promise<void> {
    const finalPath: string = this.getRulesetPath();
    const previousPath: string = this.getRulesetPreviousPath();
    if (!await this.pathExists(previousPath)) {
      return;
    }
    await this.removePath(finalPath);
    await this.restorePath(previousPath, finalPath);
  }

  private async readManifest(): Promise<AdBlockNativeRuleProviderManifest | undefined> {
    const path: string = this.getManifestPath();
    try {
      const stat = await fileIo.stat(path);
      if (stat.isDirectory() || stat.size <= 0 || stat.size > MAX_NATIVE_MANIFEST_BYTES) {
        return undefined;
      }
      const raw: string = await this.readText(path, Math.floor(stat.size));
      const value: AdBlockNativeRuleProviderManifest = JSON.parse(raw) as AdBlockNativeRuleProviderManifest;
      if (value.schemaVersion !== NATIVE_PROVIDER_SCHEMA_VERSION || typeof value.identity !== 'string' ||
        value.identity.length <= 0 || !Array.isArray(value.sourceIds) ||
        !Array.isArray(value.sourcePayloadIdentities) ||
        value.sourceIds.length !== value.sourcePayloadIdentities.length ||
        typeof value.ruleLineCount !== 'number' || value.ruleLineCount < 0) {
        return undefined;
      }
      return value;
    } catch (_error) {
      return undefined;
    }
  }

  private async writeManifest(manifest: AdBlockNativeRuleProviderManifest): Promise<void> {
    const bytes: Uint8Array = this.encoder.encodeInto(JSON.stringify(manifest));
    if (bytes.byteLength <= 0 || bytes.byteLength > MAX_NATIVE_MANIFEST_BYTES) {
      throw new Error('原生规则清单大小无效');
    }
    const finalPath: string = this.getManifestPath();
    const nextPath: string = `${finalPath}.next`;
    await this.writeBytes(nextPath, bytes, MAX_NATIVE_MANIFEST_BYTES);
    await this.removePath(finalPath);
    await fileIo.rename(nextPath, finalPath);
  }

  private async readText(path: string, size: number): Promise<string> {
    return this.decoder.decodeWithStream(await this.readBytes(path, size), { stream: false });
  }

  private async readBytes(path: string, size: number): Promise<Uint8Array> {
    let file: fileIo.File | undefined = undefined;
    try {
      file = await fileIo.open(path, fileIo.OpenMode.READ_ONLY);
      const bytes: ArrayBuffer = new ArrayBuffer(size);
      const readLength: number = await fileIo.read(file.fd, bytes);
      if (readLength !== size) {
        throw new Error('原生规则文件读取不完整');
      }
      return new Uint8Array(bytes);
    } finally {
      if (file !== undefined) {
        await fileIo.close(file).catch((_error: Error): void => {});
      }
    }
  }

  private async writeBytes(path: string, bytes: Uint8Array, limit: number): Promise<void> {
    if (bytes.byteLength <= 0 || bytes.byteLength > limit) {
      throw new Error('原生规则文件大小无效');
    }
    let file: fileIo.File | undefined = undefined;
    try {
      await this.removePath(path);
      file = await fileIo.open(
        path,
        fileIo.OpenMode.WRITE_ONLY | fileIo.OpenMode.CREATE | fileIo.OpenMode.TRUNC
      );
      const payload: ArrayBuffer = new ArrayBuffer(bytes.byteLength);
      new Uint8Array(payload).set(bytes);
      const written: number = await fileIo.write(file.fd, payload);
      await fileIo.fsync(file.fd);
      if (written !== bytes.byteLength) {
        throw new Error('原生规则文件写入不完整');
      }
    } finally {
      if (file !== undefined) {
        await fileIo.close(file).catch((_error: Error): void => {});
      }
    }
  }

  private enqueue(task: () => Promise<void>): Promise<void> {
    const next: Promise<void> = this.mutationTask
      .catch((_error: Error): void => {})
      .then(task);
    this.mutationTask = next;
    return next;
  }

  private async ensureRootDir(): Promise<void> {
    const root: string = this.getRootDir();
    if (await this.pathExists(root)) {
      return;
    }
    await fileIo.mkdir(root, true);
  }

  private async pathExists(path: string): Promise<boolean> {
    try {
      return await fileIo.access(path);
    } catch (_error) {
      return false;
    }
  }

  private async removePath(path: string): Promise<void> {
    try {
      await fileIo.unlink(path);
    } catch (_error) {
    }
  }

  private async restorePath(sourcePath: string, finalPath: string): Promise<void> {
    if (!await this.pathExists(sourcePath)) {
      return;
    }
    try {
      await this.removePath(finalPath);
      await fileIo.rename(sourcePath, finalPath);
    } catch (_error) {
    }
  }

  private isSupportedSourceId(sourceId: string): boolean {
    const normalized: string = sourceId.trim();
    return isAdBlockThirdPartyRuleSourceId(normalized) || /^custom-[0-9]+$/.test(normalized);
  }

  private buildRawPayloadIdentity(payload: Uint8Array): string {
    let primaryHash: number = RAW_PAYLOAD_HASH_SEED;
    let secondaryHash: number = RAW_PAYLOAD_HASH_SECONDARY_SEED;
    for (let index = 0; index < payload.byteLength; index += 1) {
      const value: number = payload[index];
      primaryHash ^= value;
      primaryHash = Math.imul(primaryHash, 16777619);
      secondaryHash ^= value;
      secondaryHash = Math.imul(secondaryHash, 16777619);
    }
    return `raw-v1-${this.formatHash(primaryHash)}${this.formatHash(secondaryHash)}`;
  }

  private formatHash(value: number): string {
    const normalized: string = (value >>> 0).toString(16);
    return `${'00000000'.substring(normalized.length)}${normalized}`;
  }

  private getRootDir(): string {
    return `${AppRuntimeContext.getApplicationContext().filesDir}/${NATIVE_PROVIDER_ROOT_DIR_NAME}`;
  }

  private getSourcePath(sourceId: string): string {
    return `${this.getRootDir()}/source-${sourceId}.txt`;
  }

  private getSourceNextPath(sourceId: string): string {
    return `${this.getSourcePath(sourceId)}.next`;
  }

  private getSourcePreviousPath(sourceId: string): string {
    return `${this.getSourcePath(sourceId)}.previous`;
  }

  private getSourceIdentityPath(sourceId: string): string {
    return `${this.getRootDir()}/source-${sourceId}.identity`;
  }

  private getSourceIdentityNextPath(sourceId: string): string {
    return `${this.getSourceIdentityPath(sourceId)}.next`;
  }

  private getSourceIdentityPreviousPath(sourceId: string): string {
    return `${this.getSourceIdentityPath(sourceId)}.previous`;
  }

  private getRulesetPath(): string {
    return `${this.getRootDir()}/${NATIVE_PROVIDER_RULESET_FILE_NAME}`;
  }

  private getRulesetNextPath(): string {
    return `${this.getRulesetPath()}.next`;
  }

  private getRulesetPreviousPath(): string {
    return `${this.getRulesetPath()}.previous`;
  }

  private getManifestPath(): string {
    return `${this.getRootDir()}/${NATIVE_PROVIDER_MANIFEST_FILE_NAME}`;
  }

  private skipped(
    reason: string,
    sourceCount: number,
    ruleLineCount: number = 0,
    identity: string = '',
    rulesetPath: string = '',
    sourceIds: string[] = []
  ): AdBlockNativeRuleProviderResult {
    return {
      success: true,
      applied: false,
      skipped: true,
      reason: reason,
      sourceCount: sourceCount,
      ruleLineCount: ruleLineCount,
      identity: identity,
      rulesetPath: rulesetPath,
      sourceIds: sourceIds
    };
  }

  private failure(reason: string, sourceCount: number): AdBlockNativeRuleProviderResult {
    return {
      success: false,
      applied: false,
      skipped: false,
      reason: reason,
      sourceCount: sourceCount,
      ruleLineCount: 0,
      identity: '',
      rulesetPath: '',
      sourceIds: []
    };
  }
}

export const sharedAdBlockNativeRuleProviderService: AdBlockNativeRuleProviderService =
  new AdBlockNativeRuleProviderService();
