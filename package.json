            "packages/*"
      ],
      "dependencies": {
            "@radix-ui/react-accordion": "^1.2.3",
            "@radix-ui/react-alert-dialog": "^1.1.6",
            "@radix-ui/react-aspect-ratio": "^1.1.2",
            "@radix-ui/react-avatar": "^1.1.3",
            "@radix-ui/react-checkbox": "^1.1.4",
            "@radix-ui/react-collapsible": "^1.1.3",
            "@radix-ui/react-context-menu": "^2.2.6",
            "@radix-ui/react-dialog": "^1.1.6",
            "@radix-ui/react-dropdown-menu": "^2.1.6",
            "@radix-ui/react-hover-card": "^1.1.6",
            "@radix-ui/react-label": "^2.1.2",
            "@radix-ui/react-menubar": "^1.1.6",
            "@radix-ui/react-navigation-menu": "^1.2.5",
            "@radix-ui/react-popover": "^1.1.6",
            "@radix-ui/react-progress": "^1.1.2",
            "@radix-ui/react-radio-group": "^1.2.3",
            "@radix-ui/react-scroll-area": "^1.2.3",
            "@radix-ui/react-select": "^2.1.6",
            "@radix-ui/react-separator": "^1.1.2",
            "@radix-ui/react-slider": "^1.2.3",
            "@radix-ui/react-slot": "^1.2.4",
            "@radix-ui/react-switch": "^1.1.3",
            "@radix-ui/react-tabs": "^1.1.3",
            "@radix-ui/react-toggle": "^1.1.2",
            "@radix-ui/react-toggle-group": "^1.1.2",
            "@radix-ui/react-tooltip": "^1.1.8",
            "@tailwindcss/vite": "^4.1.18",
            "class-variance-authority": "^0.7.1",
            "clsx": "*",
            "cmdk": "^1.1.1",
            "framer-motion": "^12.31.0",
            "i18next": "^25.8.4",
            "i18next-browser-languagedetector": "^8.2.0",
            "lucide-react": "^0.577.0",
            "motion": "^12.36.0",
            "next-themes": "^0.4.6",
            "react": "^18.3.1",
            "react-dom": "^18.3.1",
            "react-i18next": "^16.5.4",
            "react-use-measure": "^2.1.7",
            "tailwind-merge": "*",
            "tailwindcss": "^4.1.18",
            "tailwindcss-animate": "^1.0.7",
            "vaul": "^1.1.2"
      },
      "devDependencies": {
            "@playwright/test": "^1.58.2",
            "@testing-library/jest-dom": "^6.9.1",
            "@testing-library/react": "^16.3.2",
            "@testing-library/user-event": "^14.6.1",
            "@types/chrome": "^0.1.37",
            "@types/node": "^20.10.0",
            "@types/react": "^19.2.10",
            "@types/react-dom": "^19.2.3",
            "@vitejs/plugin-react-swc": "^3.10.2",
            "jsdom": "^27.0.1",
            "typescript": "^5.9.3",
            "vite": "6.3.5",
            "vitest": "^3.2.4"
      },
      "scripts": {
            "dev": "npm run grid:verify:host && vite --host",
            "dev:webdav": "node scripts/dev-webdav-server.cjs",
            "build": "npm run build:final",
            "typecheck": "tsc --noEmit -p tsconfig.json",
            "test": "vitest run",
            "profile:fluidity": "node scripts/profile-fluidity.mjs",
            "test:watch": "vitest",
            "check": "npm run typecheck && npm run test && npm run build",
            "grid:build:local": "npm run build --workspace @airatab/workspace-core && npm run build --workspace @airatab/workspace-react && npm run build --workspace @airatab/workspace-preset-airatab",
            "grid:prepare": "node scripts/prepare-grid-deps.mjs",
            "grid:check:local": "node scripts/prepare-grid-deps.mjs --local-only",
            "grid:check:boundaries": "node scripts/check-grid-boundaries.mjs",
            "grid:verify:host": "npm run grid:prepare && npm run grid:check:boundaries",
            "build:final": "npm run grid:verify:host && node scripts/build-final.js",
            "pack:zip": "node scripts/package-release-zips.js",
            "pack:zip:no-icons": "npm run build && node scripts/package-release-zips.js",
            "pack:zip:optimized": "npm run pack:zip:no-icons",
            "pack:release": "npm run pack:zip",
            "pack:release:all": "npm run pack:zip:optimized",
            "verify:release": "node scripts/verify-release.js"
      },
      "license": "UNLICENSED"
}
